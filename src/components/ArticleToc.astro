---
type Heading = {
  depth: number;
  slug: string;
  text: string;
};

type Props = {
  headings: Heading[];
  mode: "mobile" | "desktop";
};

const headings = Astro.props.headings.filter(
  heading => heading.depth === 2 || heading.depth === 3
);
const { mode } = Astro.props;
---

{
  headings.length > 0 &&
    (mode === "mobile" ? (
      <details class="toc-glass glass-surface-thin mx-auto mb-8 max-w-[46.5rem] px-4 py-3 xl:hidden">
        <summary class="font-medium">On this page</summary>
        <nav aria-label="Table of contents" class="mt-3">
          <ol class="text-muted-foreground space-y-1.5 text-sm">
            {headings.map(heading => (
              <li class:list={{ "ps-3": heading.depth === 3 }}>
                <a class="block px-2 py-1.5" href={`#${heading.slug}`}>
                  {heading.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </details>
    ) : (
      <aside class="hidden xl:block" data-pagefind-ignore>
        <nav
          aria-label="Table of contents"
          class="toc-glass glass-surface-thin sticky top-28 p-4"
        >
          <p class="text-muted-foreground mb-3 text-xs font-semibold tracking-[0.08em] uppercase">
            On this page
          </p>
          <ol class="text-muted-foreground space-y-1 text-sm leading-snug">
            {headings.map(heading => (
              <li class:list={{ "ps-2": heading.depth === 3 }}>
                <a class="block px-2 py-1.5" href={`#${heading.slug}`}>
                  {heading.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </aside>
    ))
}
