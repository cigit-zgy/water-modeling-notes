---
type Heading = {
  depth: number;
  slug: string;
  text: string;
};

type Props = {
  headings: Heading[];
  mode: "mobile" | "desktop";
  label?: string;
  ariaLabel?: string;
};

const headings = Astro.props.headings.filter(
  heading => heading.depth === 2 || heading.depth === 3
);
const {
  mode,
  label = "On this page",
  ariaLabel = "Table of contents",
} = Astro.props;
---

{
  headings.length > 0 &&
    (mode === "mobile" ? (
      <details class="border-border mx-auto mb-8 max-w-[46.5rem] border-y py-3 xl:hidden">
        <summary class="font-medium">{label}</summary>
        <nav aria-label={ariaLabel} class="mt-3">
          <ol class="text-muted-foreground space-y-2 text-sm">
            {headings.map(heading => (
              <li class:list={{ "ps-4": heading.depth === 3 }}>
                <a class="hover:text-link" href={`#${heading.slug}`}>
                  {heading.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </details>
    ) : (
      <aside class="hidden xl:block" data-pagefind-ignore>
        <nav
          aria-label={ariaLabel}
          class="border-border sticky top-8 border-s ps-5"
        >
          <p class="text-muted-foreground mb-3 text-xs font-semibold tracking-[0.08em] uppercase">
            {label}
          </p>
          <ol class="text-muted-foreground space-y-2 text-sm leading-snug">
            {headings.map(heading => (
              <li class:list={{ "ps-3": heading.depth === 3 }}>
                <a class="hover:text-link" href={`#${heading.slug}`}>
                  {heading.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </aside>
    ))
}
