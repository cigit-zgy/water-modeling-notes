---
type Kind =
  | "note"
  | "tip"
  | "description"
  | "definition"
  | "method"
  | "important"
  | "caution"
  | "warning"
  | "example"
  | "code";

type Props = {
  kind?: Kind;
  label?: string;
};

const { kind = "note", label } = Astro.props;
const labels: Record<Kind, string> = {
  note: "Note",
  tip: "Tip",
  description: "Description",
  definition: "Definition",
  method: "Method",
  important: "Important",
  caution: "Caution",
  warning: "Warning",
  example: "Example",
  code: "Code",
};
---

<aside
  class="academic-callout"
  data-kind={kind}
  aria-label={label ?? labels[kind]}
>
  <p class="academic-callout__label">{label ?? labels[kind]}</p>
  <div class="academic-callout__body"><slot /></div>
</aside>
