---
import { deflateSync } from "node:zlib";

type Props = {
  code: string;
  alt?: string;
};

const {
  code,
  alt = "sci-manuscript-skill 稿件生命周期流程图",
} = Astro.props;

const encoded = deflateSync(Buffer.from(code, "utf8")).toString("base64url");
const renderUrl = `https://kroki.io/mermaid/svg/${encoded}`;
---

<figure class="mermaid-figure" data-pagefind-ignore>
  <div class="mermaid-image-shell">
    <img
      class="mermaid-image"
      src={renderUrl}
      alt={alt}
      loading="eager"
      decoding="async"
    />
  </div>
  <figcaption><slot /></figcaption>
</figure>

<style>
  .mermaid-figure {
    margin-block: 2rem;
    overflow: hidden;
  }

  .mermaid-image-shell {
    width: 100%;
    max-width: 100%;
    padding: 1rem;
    overflow: hidden;
    border: 1px solid var(--code-border);
    border-radius: 0.5rem;
    background: #1b2130;
  }

  .mermaid-image {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
    border: 0;
    background: transparent;
  }

  .mermaid-figure figcaption {
    margin-top: 0.75rem;
    color: var(--text-muted);
    font-family: var(--font-ui);
    font-size: 0.9rem;
    line-height: 1.55;
    text-align: center;
  }

  @media (max-width: 639px) {
    .mermaid-image-shell {
      padding: 0.5rem;
    }
  }
</style>
