---
type Props = {
  code: string;
  alt?: string;
};

const { code, alt = "sci-manuscript-skill 稿件生命周期流程图" } = Astro.props;

const safeCode = code
  .split("\n")
  .filter(line => {
    const value = line.trim();
    return !value.startsWith("classDef ") && !value.startsWith("class ");
  })
  .join("\n")
  .trim();
---

<figure class="mermaid-figure" data-pagefind-ignore>
  <div
    class="mermaid-shell"
    data-mermaid-shell
    data-mermaid-source={safeCode}
    role="img"
    aria-label={alt}
  >
    <div class="mermaid-output" aria-hidden="true"></div>
    <div class="mermaid-fallback" aria-hidden="true">
      <span>科研项目</span>
      <i>→</i>
      <span>环境检查</span>
      <i>→</i>
      <span>r00</span>
      <i>→</i>
      <span>revision</span>
      <i>→</i>
      <span>submission</span>
      <i>→</i>
      <span>handoff</span>
    </div>
  </div>
  <figcaption><slot /></figcaption>
</figure>

<script is:inline type="module" data-astro-rerun>
  async function renderMermaidDiagrams() {
    const shells = Array.from(
      document.querySelectorAll(
        "[data-mermaid-shell]:not([data-rendered='true'])"
      )
    );
    if (shells.length === 0) return;

    try {
      const { default: mermaid } =
        await import("https://cdn.jsdelivr.net/npm/mermaid@11.16.1/dist/mermaid.esm.min.mjs");

      const isDark = document.documentElement.dataset.theme !== "light";
      const palette = isDark
        ? {
            background: "#1C1C1E",
            primary: "#2C2C2E",
            secondary: "#242426",
            tertiary: "#3A3A3C",
            text: "#F5F5F7",
            muted: "#8E8E93",
            accent: "#0A84FF",
          }
        : {
            background: "#FFFFFF",
            primary: "#F2F2F7",
            secondary: "#FFFFFF",
            tertiary: "#E5E5EA",
            text: "#1D1D1F",
            muted: "#8E8E93",
            accent: "#007AFF",
          };

      mermaid.initialize({
        startOnLoad: false,
        securityLevel: "strict",
        theme: "base",
        fontFamily: '"LXGW WenKai Screen", sans-serif',
        themeVariables: {
          background: palette.background,
          primaryColor: palette.primary,
          primaryTextColor: palette.text,
          primaryBorderColor: palette.accent,
          secondaryColor: palette.secondary,
          secondaryTextColor: palette.text,
          secondaryBorderColor: palette.muted,
          tertiaryColor: palette.tertiary,
          tertiaryTextColor: palette.text,
          tertiaryBorderColor: palette.muted,
          lineColor: palette.muted,
          textColor: palette.text,
          edgeLabelBackground: palette.background,
          clusterBkg: palette.secondary,
          clusterBorder: palette.muted,
          fontFamily: '"LXGW WenKai Screen", sans-serif',
        },
        flowchart: {
          useMaxWidth: true,
          htmlLabels: false,
          curve: "basis",
          nodeSpacing: 30,
          rankSpacing: 42,
        },
      });

      for (let index = 0; index < shells.length; index += 1) {
        const shell = shells[index];
        const source = shell.dataset.mermaidSource?.trim();
        const output = shell.querySelector(".mermaid-output");
        if (!source || !output) continue;

        try {
          const id = `mermaid-${Date.now()}-${index}`;
          const { svg, bindFunctions } = await mermaid.render(id, source);
          output.innerHTML = svg;
          bindFunctions?.(output);
          shell.dataset.rendered = "true";
        } catch {
          /* Keep the quiet structural fallback visible. */
        }
      }
    } catch {
      /* Keep the quiet structural fallback visible. */
    }
  }

  renderMermaidDiagrams();
  document.addEventListener("astro:page-load", renderMermaidDiagrams);
</script>

<style>
  .mermaid-figure {
    margin-block: 2rem;
    max-width: 100%;
    overflow: hidden;
  }

  .mermaid-shell {
    width: 100%;
    max-width: 100%;
    min-height: 10rem;
    padding: 1rem;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    border-radius: 1rem;
    background: color-mix(
      in srgb,
      var(--background-secondary) 92%,
      transparent
    );
    box-shadow: inset 0 1px 0 var(--glass-specular-soft);
  }

  .mermaid-output:empty {
    display: none;
  }

  .mermaid-output :global(svg) {
    display: block;
    width: 100% !important;
    max-width: 100% !important;
    height: auto !important;
    margin-inline: auto;
  }

  .mermaid-output :global(svg text) {
    font-family: "LXGW WenKai Screen", sans-serif !important;
  }

  .mermaid-fallback {
    display: flex;
    min-height: 8rem;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    color: var(--text-primary);
    font-family: var(--font-ui);
    font-size: 0.92rem;
    line-height: 1.35;
    text-align: center;
    flex-wrap: wrap;
  }

  .mermaid-fallback span {
    padding: 0.55rem 0.72rem;
    border: 1px solid var(--border-subtle);
    border-radius: 0.7rem;
    background: var(--background-elevated);
  }

  .mermaid-fallback i {
    color: var(--accent-primary);
    font-style: normal;
  }

  .mermaid-shell[data-rendered="true"] .mermaid-fallback {
    display: none;
  }

  .mermaid-figure figcaption {
    margin-top: 0.8rem;
    color: var(--text-muted);
    font-family: var(--font-ui);
    font-size: 0.96rem;
    line-height: 1.55;
    text-align: center;
  }

  @media (max-width: 639px) {
    .mermaid-shell {
      padding: 0.6rem;
    }

    .mermaid-fallback {
      gap: 0.4rem;
      font-size: 0.84rem;
    }
  }
</style>
