---
type Props = {
  code: string;
  alt?: string;
};

const {
  code,
  alt = "sci-manuscript-skill 稿件生命周期流程图",
} = Astro.props;

/*
 * Diagram presentation is centralized here. Older article drafts may contain
 * classDef/class lines; strip those directives so article content cannot create
 * a parallel colour system or override the global diagram theme.
 */
const safeCode = code
  .split("\n")
  .filter(line => {
    const value = line.trim();
    return !value.startsWith("classDef ") && !value.startsWith("class ");
  })
  .join("\n")
  .trim();
---

<figure class="mermaid-figure" data-pagefind-ignore>
  <div
    class="mermaid-shell"
    data-mermaid-shell
    data-mermaid-source={safeCode}
    role="img"
    aria-label={alt}
  >
    <div class="mermaid-output" aria-hidden="true"></div>
    <div class="mermaid-fallback" aria-hidden="true">
      <span>科研项目</span>
      <i>→</i>
      <span>环境检查</span>
      <i>→</i>
      <span>r00</span>
      <i>→</i>
      <span>revision</span>
      <i>→</i>
      <span>submission</span>
      <i>→</i>
      <span>handoff</span>
    </div>
  </div>
  <figcaption><slot /></figcaption>
</figure>

<script is:inline type="module" data-astro-rerun>
  async function renderMermaidDiagrams() {
    const shells = Array.from(
      document.querySelectorAll("[data-mermaid-shell]:not([data-rendered='true'])")
    );
    if (shells.length === 0) return;

    try {
      const { default: mermaid } = await import(
        "https://cdn.jsdelivr.net/npm/mermaid@11.16.1/dist/mermaid.esm.min.mjs"
      );

      mermaid.initialize({
        startOnLoad: false,
        securityLevel: "strict",
        theme: "base",
        fontFamily: '"LXGW WenKai Screen", sans-serif',
        themeVariables: {
          background: "#191A21",
          primaryColor: "#21222C",
          primaryTextColor: "#F8F8F2",
          primaryBorderColor: "#BD93F9",
          secondaryColor: "#253340",
          secondaryTextColor: "#F8F8F2",
          secondaryBorderColor: "#8BE9FD",
          tertiaryColor: "#343746",
          tertiaryTextColor: "#F8F8F2",
          tertiaryBorderColor: "#50FA7B",
          lineColor: "#6272A4",
          textColor: "#F8F8F2",
          edgeLabelBackground: "#191A21",
          clusterBkg: "#21222C",
          clusterBorder: "#6272A4",
          fontFamily: '"LXGW WenKai Screen", sans-serif',
        },
        flowchart: {
          useMaxWidth: true,
          htmlLabels: false,
          curve: "linear",
          nodeSpacing: 30,
          rankSpacing: 42,
        },
      });

      for (let index = 0; index < shells.length; index += 1) {
        const shell = shells[index];
        const source = shell.dataset.mermaidSource?.trim();
        const output = shell.querySelector(".mermaid-output");
        if (!source || !output) continue;

        try {
          const id = `mermaid-${Date.now()}-${index}`;
          const { svg, bindFunctions } = await mermaid.render(id, source);
          output.innerHTML = svg;
          bindFunctions?.(output);
          shell.dataset.rendered = "true";
        } catch {
          /* Keep the structural fallback visible; never expose parser errors. */
        }
      }
    } catch {
      /* Keep the structural fallback visible if the pinned module is unavailable. */
    }
  }

  renderMermaidDiagrams();
  document.addEventListener("astro:page-load", renderMermaidDiagrams);
</script>

<style>
  .mermaid-figure {
    margin-block: 2rem;
    max-width: 100%;
    overflow: hidden;
  }

  .mermaid-shell {
    width: 100%;
    max-width: 100%;
    min-height: 10rem;
    padding: 1rem;
    overflow: hidden;
    border: 1px solid #343746;
    border-radius: 0.5rem;
    background: #191a21;
  }

  .mermaid-output:empty {
    display: none;
  }

  .mermaid-output :global(svg) {
    display: block;
    width: 100% !important;
    max-width: 100% !important;
    height: auto !important;
    margin-inline: auto;
  }

  .mermaid-output :global(svg text) {
    font-family: "LXGW WenKai Screen", sans-serif !important;
  }

  .mermaid-fallback {
    display: flex;
    min-height: 8rem;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    color: #f8f8f2;
    font-family: var(--font-ui);
    font-size: 0.92rem;
    line-height: 1.35;
    text-align: center;
    flex-wrap: wrap;
  }

  .mermaid-fallback span {
    padding: 0.55rem 0.7rem;
    border: 1px solid #6272a4;
    border-radius: 0.35rem;
    background: #21222c;
  }

  .mermaid-fallback i {
    color: #ffb86c;
    font-style: normal;
  }

  .mermaid-shell[data-rendered="true"] .mermaid-fallback {
    display: none;
  }

  .mermaid-figure figcaption {
    margin-top: 0.8rem;
    color: var(--text-muted);
    font-family: var(--font-ui);
    font-size: 0.94rem;
    line-height: 1.55;
    text-align: center;
  }

  @media (max-width: 639px) {
    .mermaid-shell {
      padding: 0.55rem;
    }

    .mermaid-fallback {
      gap: 0.4rem;
      font-size: 0.84rem;
    }
  }
</style>
