---
import { deflateSync } from "node:zlib";

type Props = {
  code: string;
  alt?: string;
};

const {
  code,
  alt = "sci-manuscript-skill 稿件生命周期流程图",
} = Astro.props;

const encoded = deflateSync(Buffer.from(code, "utf8")).toString("base64url");
const renderUrl = `https://kroki.io/mermaid/svg/${encoded}`;
const response = await fetch(renderUrl, {
  signal: AbortSignal.timeout(15000),
});

if (!response.ok) {
  throw new Error(
    `Mermaid build-time rendering failed: ${response.status} ${response.statusText}`
  );
}

const svg = await response.text();

if (!svg.includes("<svg")) {
  throw new Error("Mermaid build-time rendering returned invalid SVG output.");
}
---

<figure class="mermaid-figure" data-pagefind-ignore>
  <div
    class="mermaid-svg"
    role="img"
    aria-label={alt}
    set:html={svg}
  />
  <figcaption><slot /></figcaption>
</figure>

<style>
  .mermaid-figure {
    margin-block: 2rem;
    overflow: hidden;
  }

  .mermaid-svg {
    width: 100%;
    max-width: 100%;
    padding: 1rem;
    overflow: hidden;
    border: 1px solid var(--code-border);
    border-radius: 0.5rem;
    background: #1b2130;
  }

  .mermaid-figure figcaption {
    margin-top: 0.75rem;
    color: var(--text-muted);
    font-family: var(--font-ui);
    font-size: 0.9rem;
    line-height: 1.55;
    text-align: center;
  }

  :global(.mermaid-svg svg) {
    display: block;
    width: 100% !important;
    max-width: 100% !important;
    height: auto !important;
    margin-inline: auto;
  }

  :global(.mermaid-svg svg text) {
    font-family: "LXGW WenKai Screen", sans-serif !important;
  }

  @media (max-width: 639px) {
    .mermaid-svg {
      padding: 0.5rem;
    }
  }
</style>
