---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";
import { useTranslations } from "@/i18n";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const t = useTranslations(Astro.currentLocale);
const currentYear = new Date().getFullYear();
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="border-border text-muted-foreground flex flex-col gap-1 border-t py-6 text-sm sm:flex-row sm:items-center sm:justify-between"
  >
    <p>
      {t.footer.copyright} &#169; {currentYear} · {t.footer.allRightsReserved}
    </p>
    <Socials />
    <p>
      Built on <a
        class="text-link hover:text-foreground underline underline-offset-4"
        href="https://github.com/satnaing/astro-paper">AstroPaper</a
      >.
    </p>
  </div>
</footer>
