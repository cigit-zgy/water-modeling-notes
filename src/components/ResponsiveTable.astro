---
type Props = {
  class?: string;
  caption?: string;
  variant?:
    /** No borders. Zebra striping is applied globally by the academic design system. */
    | "minimal"
    /** Explicit zebra variant retained for backwards compatibility. */
    | "striped"
    /** No borders with explicit zebra variant. */
    | "striped-minimal";
};

const {
  class: className,
  caption,
  variant = "minimal",
} = Astro.props;

const variantClasses = {
  minimal: "[&_td]:border-0 [&_th]:border-0",
  striped: "[&_tbody_tr]:even:bg-muted/20",
};
---

<figure
  class:list={[
    "academic-table",
    className,
  ]}
>
  {
    caption && (
      <figcaption class="academic-table__caption">{caption}</figcaption>
    )
  }
  <div
    data-table-variant={variant}
    class:list={[
      "overflow-hidden rounded-md [&_table]:my-0 [&_table]:min-w-xl",
      variant === "minimal" && variantClasses.minimal,
      variant === "striped" && variantClasses.striped,
      variant === "striped-minimal" &&
        `${variantClasses.minimal} ${variantClasses.striped}`,
    ]}
  >
    <div class="relative w-full overflow-x-auto">
      <slot />
    </div>
  </div>
</figure>
