---
type Props = {
  class?: string;
  caption?: string;
  variant?: "minimal" | "striped" | "striped-minimal";
};

const {
  class: className,
  caption,
  variant = "minimal",
} = Astro.props;

/* Zebra colouring is intentionally global in refinements.css. Do not attach
 * Tailwind row-background utilities here: they compete with the global design
 * system and make odd/even contrast browser-order dependent. */
const minimalClasses = "[&_td]:border-0 [&_th]:border-0";
---

<figure class:list={["academic-table", className]}>
  {
    caption && (
      <figcaption class="academic-table__caption">{caption}</figcaption>
    )
  }
  <div
    data-table-variant={variant}
    class:list={[
      "overflow-hidden rounded-md [&_table]:my-0 [&_table]:min-w-xl",
      (variant === "minimal" || variant === "striped-minimal") &&
        minimalClasses,
    ]}
  >
    <div class="relative w-full overflow-x-auto">
      <slot />
    </div>
  </div>
</figure>
