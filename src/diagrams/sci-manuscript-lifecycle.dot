digraph ManuscriptLifecycle {
  graph [
    rankdir=TB,
    bgcolor="transparent",
    pad=0.22,
    nodesep=0.36,
    ranksep=0.52,
    splines=polyline,
    outputorder=edgesfirst,
    fontname="LXGW WenKai Screen"
  ];

  node [
    shape=box,
    style="rounded,filled",
    fillcolor="#1C1C1E",
    color="#636366",
    fontcolor="#F5F5F7",
    fontname="LXGW WenKai Screen",
    fontsize=12,
    penwidth=1.25,
    margin="0.18,0.11"
  ];

  edge [
    color="#8E8E93",
    fontcolor="#AEAEB2",
    fontname="LXGW WenKai Screen",
    fontsize=10,
    penwidth=1.15,
    arrowsize=0.72
  ];

  project [label="已有科研项目", fillcolor="#242426"];
  doctor [label="doctor\n环境检查", color="#64D2FF", penwidth=1.7];
  r00 [label="init\ninitial_submission / r00", color="#0A84FF", penwidth=1.8];
  edit0 [label="显式编辑 manuscript"];
  build [label="build\nclean manuscript", color="#64D2FF", penwidth=1.7];
  task [label="当前任务", shape=diamond, style="filled", fillcolor="#242426", color="#BF5AF2", penwidth=1.6, margin="0.12,0.06"];
  first [label="submission package"];
  revision [label="revision\nrevision_01 / r01", color="#0A84FF", penwidth=1.8];
  edit1 [label="显式修改\n正文 + responses", color="#BF5AF2", penwidth=1.55];
  submit [label="submission", color="#0A84FF", penwidth=1.8];
  bundle [label="clean + marked + response letter + package", color="#30D158", penwidth=1.65];
  again [label="还有下一轮审稿？", shape=diamond, style="filled", fillcolor="#242426", color="#BF5AF2", penwidth=1.6, margin="0.12,0.06"];
  final [label="Final handoff", fillcolor="#242426"];
  archive [label="rollback\n00_archive", color="#FF9F0A", penwidth=1.5];

  { rank=same; revision; archive; }

  project -> doctor -> r00 -> edit0 -> build -> task;
  task -> first [label="初次投稿"];
  task -> revision [label="收到审稿意见"];
  revision -> edit1 -> submit -> bundle -> again;
  again -> revision [label="是", constraint=false, color="#0A84FF", fontcolor="#64D2FF"];
  again -> final [label="否"];
  revision -> archive [style=dashed, color="#FF9F0A", fontcolor="#FFB340", constraint=false];
}
