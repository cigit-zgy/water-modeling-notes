---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const topics = [
  {
    title: "Mechanistic wastewater process modelling",
    description:
      "Representing treatment-process states, transformations, and constraints with interpretable mechanistic models.",
  },
  {
    title: "Hybrid mechanistic–data-driven modelling",
    description:
      "Combining process knowledge with learned components while preserving meaningful state and parameter structure.",
  },
  {
    title: "Scientific machine learning for dynamic systems",
    description:
      "Studying differential-equation-based learning, system identification, and reliable evaluation for dynamic processes.",
  },
  {
    title: "Computational methods for environmental process models",
    description:
      "Numerical methods, scientific Python workflows, and reproducible implementations for environmental modelling.",
  },
];
---

<Layout
  title={`Research | ${config.site.title}`}
  description="A map of the research themes covered by cigit-zgy."
>
  <Header />
  <Main
    pageTitle="Research"
    pageDesc="A map of the questions and methods that guide this notebook."
  >
    <div class="mt-10">
      {
        topics.map((topic, index) => (
          <section class="border-border grid gap-3 border-t py-7 sm:grid-cols-[3rem_1fr]">
            <span class="text-link text-xs" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <div>
              <h2 class="text-xl font-semibold tracking-[-0.015em]">
                {topic.title}
              </h2>
              <p class="text-muted-foreground mt-3 max-w-2xl leading-relaxed">
                {topic.description}
              </p>
            </div>
          </section>
        ))
      }
    </div>
  </Main>
  <Footer />
</Layout>
