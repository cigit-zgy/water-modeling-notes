---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const issues = (await getCollection("paperReviewIssues", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDatetime.valueOf() - a.data.pubDatetime.valueOf()
);

const dateFormatter = new Intl.DateTimeFormat(Astro.currentLocale ?? config.site.lang, {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: config.site.timezone,
});
---

<Layout
  title={`Paper Review | ${config.site.title}`}
  description="Weekly research radar for transferable methods in wastewater modelling, scientific machine learning and scientific AI."
>
  <Header />
  <Main
    pageTitle="Paper Review"
    pageDesc="A weekly research radar focused on methods that can change how wastewater process models are built, analysed and operated."
  >
    <div class="mt-10">
      {
        issues.map(issue => (
          <article class="border-border border-t py-7">
            <div class="flex flex-wrap items-baseline justify-between gap-3">
              <h2 class="text-xl font-semibold tracking-[-0.015em]">
                <a class="text-link focus-outline" href={`/paper-review/${issue.data.issue}/`}>
                  {issue.data.title}
                </a>
              </h2>
              <time class="text-muted-foreground text-sm" datetime={issue.data.pubDatetime.toISOString()}>
                {dateFormatter.format(issue.data.pubDatetime)}
              </time>
            </div>
            <p class="text-muted-foreground mt-3 max-w-3xl leading-relaxed">
              {issue.data.description}
            </p>
            <p class="text-muted-foreground mt-3 text-xs tracking-[0.05em] uppercase">
              {issue.data.reviewStage} review
            </p>
          </article>
        ))
      }
    </div>
  </Main>
  <Footer />
</Layout>
