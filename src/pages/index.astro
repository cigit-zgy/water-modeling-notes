---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const sortedPosts = getSortedPosts(await getCollection("posts"));
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

const researchTopics = [
  {
    title: "Wastewater Modelling",
    description:
      "Mechanistic representations of biological treatment processes.",
  },
  {
    title: "Scientific Machine Learning",
    description:
      "Hybrid and neural differential-equation models for dynamic systems.",
  },
  {
    title: "Scientific Computing",
    description: "Reproducible numerical methods and Python workflows.",
  },
  {
    title: "Research Notes",
    description:
      "Working explanations, notation, and literature-linked observations.",
  },
];
---

<Layout>
  <Header />
  <main id="main-content" class="app-layout">
    <section class="border-border border-b pt-16 pb-14 sm:pt-24 sm:pb-20">
      <p class="text-link text-xs font-semibold tracking-[0.12em] uppercase">
        Academic research notebook
      </p>
      <div class="mt-5 flex items-center gap-1.5" aria-hidden="true">
        <span class="bg-spectrum-purple h-1.5 w-8 rounded-full"></span>
        <span class="bg-spectrum-magenta h-1.5 w-4 rounded-full"></span>
        <span class="bg-spectrum-cyan h-1.5 w-4 rounded-full"></span>
        <span class="bg-spectrum-teal h-1.5 w-4 rounded-full"></span>
        <span class="bg-spectrum-amber h-1.5 w-4 rounded-full"></span>
      </div>
      <h1
        class="mt-5 max-w-3xl text-4xl leading-[1.08] font-semibold tracking-[-0.04em] sm:text-6xl"
      >
        cigit-zgy
      </h1>
      <p
        class="text-muted-foreground mt-6 max-w-2xl text-xl leading-relaxed sm:text-2xl"
      >
        Wastewater process modelling, scientific machine learning, and
        computational methods.
      </p>
    </section>

    <section class="border-border border-b py-12 sm:py-14">
      <div class="mb-5 flex items-baseline justify-between gap-4">
        <h2 class="text-2xl font-semibold tracking-[-0.02em]">
          Featured Writing
        </h2>
        <a
          class="text-link text-sm underline underline-offset-4"
          href={getRelativeLocaleUrl(locale, "writing")}>All writing</a
        >
      </div>
      {
        featuredPosts.length > 0 ? (
          <ul>
            {featuredPosts.map(post => (
              <Card variant="h3" {...post} />
            ))}
          </ul>
        ) : (
          <p class="border-border text-muted-foreground border-t py-5">
            No featured essays have been published yet.
          </p>
        )
      }
    </section>

    <section class="border-border border-b py-12 sm:py-14">
      <h2 class="mb-5 text-2xl font-semibold tracking-[-0.02em]">
        Recent Writing
      </h2>
      {
        recentPosts.length > 0 ? (
          <ul>
            {recentPosts.slice(0, config.posts.perIndex).map(post => (
              <Card variant="h3" {...post} />
            ))}
          </ul>
        ) : (
          <p class="border-border text-muted-foreground border-t py-5">
            The first published research note will appear here.
          </p>
        )
      }
    </section>

    <section class="py-12 sm:py-14">
      <h2 class="mb-6 text-2xl font-semibold tracking-[-0.02em]">
        Research Topics
      </h2>
      <div class="research-spectrum grid gap-x-10 md:grid-cols-2">
        {
          researchTopics.map(topic => (
            <section class="border-border border-t py-5">
              <h3 class="font-semibold">{topic.title}</h3>
              <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
                {topic.description}
              </p>
            </section>
          ))
        }
      </div>
      <a
        class="text-link mt-4 inline-block underline underline-offset-4"
        href={getRelativeLocaleUrl(locale, "research")}
      >
        View the research map
      </a>
    </section>
  </main>
  <Footer />
</Layout>
