---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const sortedPosts = getSortedPosts(await getCollection("posts"));
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

const researchTopics = [
  {
    title: "Wastewater Modelling",
    description:
      "Mechanistic representations of biological treatment processes.",
  },
  {
    title: "Scientific Machine Learning",
    description:
      "Hybrid and neural differential-equation models for dynamic systems.",
  },
  {
    title: "Scientific Computing",
    description: "Reproducible numerical methods and Python workflows.",
  },
  {
    title: "Research Notes",
    description:
      "Working explanations, notation, and literature-linked observations.",
  },
];
---

<Layout>
  <Header />
  <main id="main-content" class="app-layout">
    <section class="home-hero">
      <div>
        <p
          class="home-hero__eyebrow"
          data-reveal
          style="--reveal-delay: 40ms"
        >
          Academic research notebook
        </p>
        <h1
          class="home-hero__title"
          data-reveal
          style="--reveal-delay: 100ms"
        >
          cigit-zgy
        </h1>
        <p
          class="home-hero__lede"
          data-reveal
          style="--reveal-delay: 160ms"
        >
          Wastewater process modelling, scientific machine learning, and
          computational methods.
        </p>
        <div
          class="home-hero__actions"
          data-reveal
          style="--reveal-delay: 220ms"
        >
          <a
            class="home-primary-action"
            href={getRelativeLocaleUrl(locale, "writing")}
          >
            Explore writing
          </a>
          <a
            class="home-secondary-action"
            href={getRelativeLocaleUrl(locale, "research")}
          >
            Research map
          </a>
        </div>
      </div>
    </section>

    <section class="home-section border-border border-t">
      <p class="home-section__eyebrow" data-reveal>Featured</p>
      <h2 class="home-section__heading" data-reveal>
        Research writing, foregrounded.
      </h2>
      <p class="home-section__lead" data-reveal>
        Long-form notes on modelling systems, scientific computation, and the
        engineering required to make research workflows explicit and
        reproducible.
      </p>

      <div class="home-featured-panel glass-surface" data-reveal>
        {
          featuredPosts.length > 0 ? (
            <ul>
              {featuredPosts.map(post => (
                <Card variant="h2" {...post} />
              ))}
            </ul>
          ) : (
            <p class="text-muted-foreground py-5">
              No featured essays have been published yet.
            </p>
          )
        }
      </div>

      <a
        class="text-link mt-6 inline-block text-sm underline underline-offset-4"
        href={getRelativeLocaleUrl(locale, "writing")}
        data-reveal
      >
        View all writing
      </a>
    </section>

    <section class="home-section border-border border-t">
      <p class="home-section__eyebrow" data-reveal>Latest</p>
      <h2 class="home-section__heading" data-reveal>Recent writing.</h2>
      <div class="home-editorial-list" data-reveal>
        {
          recentPosts.length > 0 ? (
            <ul>
              {recentPosts.slice(0, config.posts.perIndex).map(post => (
                <Card variant="h3" {...post} />
              ))}
            </ul>
          ) : (
            <p class="text-muted-foreground py-5">
              The next published research note will appear here.
            </p>
          )
        }
      </div>
    </section>

    <section class="home-section border-border border-t">
      <p class="home-section__eyebrow" data-reveal>Research system</p>
      <h2 class="home-section__heading" data-reveal>
        Four connected areas of work.
      </h2>
      <p class="home-section__lead" data-reveal>
        The site is organized around mechanistic modelling, scientific machine
        learning, reproducible computation, and the notes that connect them.
      </p>

      <div class="home-topics-grid">
        {
          researchTopics.map((topic, index) => (
            <section
              class="home-topic-panel glass-surface-thin"
              data-reveal
              style={`--reveal-delay: ${index * 70}ms`}
            >
              <span class="home-topic-panel__index">
                {String(index + 1).padStart(2, "0")}
              </span>
              <h3>{topic.title}</h3>
              <p>{topic.description}</p>
            </section>
          ))
        }
      </div>

      <a
        class="text-link mt-7 inline-block underline underline-offset-4"
        href={getRelativeLocaleUrl(locale, "research")}
        data-reveal
      >
        View the research map
      </a>
    </section>
  </main>
  <Footer />
</Layout>
